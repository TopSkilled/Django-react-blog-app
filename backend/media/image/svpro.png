s="text-gray-700 text-sm">$200</div></div></div></div></div></section><div class="fixed bottom-6 right-6 z-50"><div id="chat-fly-btn" onclick="toggleChatFly()" class="cursor-pointer bg-black text-white h-12 px-4 rounded-full flex items-center gap-2 shadow-lg"><i class="fa fa-comments"></i> Chat ERS_ART</div></div><div id="chat-fly-panel" class="fixed bottom-24 right-6 z-50 w-[360px] h-[480px] bg-white border rounded-xl shadow-xl hidden flex flex-col"><div class="flex items-center justify-between px-4 py-3 border-b"><span class="font-semibold text-sm">Chat ERS_ART</span><button onclick="toggleChatFly()"><i class="fa fa-times"></i></button></div><div id="chat-content" class="flex-1 w-full"></div></div><script type="text/javascript">document.addEventListener("DOMContentLoaded",()=>{const imgs=document.querySelectorAll('img[data-src]');const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(!entry.isIntersecting)return;const img=entry.target;img.src=img.dataset.src;img.removeAttribute('data-src');observer.unobserve(img)})},{rootMargin:"200px"});imgs.forEach(img=>observer.observe(img))});function loadChatIframe(){fetch('account/chat/check',{credentials:'include'}).then(res=>res.json()).then(data=>{const container=document.getElementById('chat-content');if(data.logged===true){if(!data.buyer){container.innerHTML=`<div class="h-full flex flex-col items-center justify-center text-center px-6"><p class="text-sm text-gray-600 mb-2">You are logged in as a designer.</p><p class="text-xs text-gray-400">Chat is available for buyers only.</p></div>`;return}container.innerHTML=`<div id="chat-loader"class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-gray-400 bg-white z-10"><svg class="animate-spin h-5 w-5"viewBox="0 0 24 24"><circle class="opacity-25"cx="12"cy="12"r="10"stroke="currentColor"stroke-width="4"fill="none"></circle><path class="opacity-75"fill="currentColor"d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg><p class="text-xs">Connecting to chat…</p></div><iframe class="w-full h-full"onload="document.getElementById('chat-loader')?.remove()"src="https://www.logoku.com/account/chat/talk?sid=3982"></iframe>`}else{container.innerHTML=`<div class="h-full flex flex-col items-center justify-center text-center px-6"><p class="text-sm text-gray-600 mb-4">Please login to continue chat with ERS_ART</p><a href="/login"target="_top"class="bg-black text-white px-6 py-3 text-xs font-bold uppercase tracking-widest">Login</a></div>`}})}function toggleChatFly(){const panel=document.getElementById('chat-fly-panel');panel.classList.toggle('hidden');if(!panel.classList.contains('loaded')){loadChatIframe();panel.classList.add('loaded')}}function reportMod(content){window.open(content)}$(function(){var $addcart=$('#addcart');var $form=$('#productform');if(!$addcart.length||!$form.length){return}$addcart.removeAttr('onclick');$addcart.on('click',function(e){e.preventDefault();var submitted=$form.find("input[type='text'], "+"input[type='hidden'], "+"input[type='radio']:checked, "+"select, "+"input[type='file']");if(typeof pintrk==='function'){pintrk('track','addtocart',{value:200.00,order_quantity:1,currency:'USD'})}$.ajax({type:'post',url:'index/cart/addcart',data:submitted,dataType:'html',success:function(html){$('html, body').animate({scrollTop:0},'slow');$('#cart-message').remove();var message='<div id="cart-message" class="max-w-7xl mx-auto px-6 py-4 mb-6 text-sm text-center border border-red-200 bg-red-50 text-red-700">'+html+'</div>';$('#breadcrumb').after(message);setTimeout(function(){$('#cart-message').fadeOut(300,function(){$(this).remove()})},5000)},complete:function(){$('#cart').load(location.href+' #cart > *')}})})});</script><style media="screen">.mockup.bottle::after{background:#000;content:"";position:absolute;inset:0;z-index:5}.vertical-text{transform:rotate(-90deg);transform-origin:left top;white-space:nowrap}.mockup.bottle .logo{transform:rotate(-21deg);left:29.6%;top:36%;position:absolute;