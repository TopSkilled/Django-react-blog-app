skew(0deg,4deg)}.mockup.instagram .logo{left:40%;bottom:42%;width:45%;z-index:0}.mockup.instagram img.logo{transform:perspective(100px) rotateY(0deg) rotateX(0deg) rotateZ(-7deg) skew(0deg,-1deg)}.mockup.namecard::after{background:#000;content:"";opacity:.7;position:absolute;inset:0;z-index:5}.mockup.namecard{overflow:hidden}.mockup.namecard .logo{left:4%;bottom:17%;width:100%;mix-blend-mode:luminosity}.mockup.namecard img.logo{transform:perspective(200px) rotateY(0deg) rotateX(14deg) rotateZ(-42deg) skew(10deg,26deg)}</style><footer class="bg-white mt-24 border-t border-gray-100"><div class="max-w-7xl mx-auto px-6 py-20"><div class="grid grid-cols-1 md:grid-cols-5 gap-12"><div class="md:col-span-2"><img src="https://www.logoku.com/logoku-black.svg" alt="Logoku" class="h-8 mb-6"><p class="text-sm text-gray-600 leading-relaxed">Discover Our Exclusive Ready Made Logo Designs for Your Business <br/>Explore our wide range of professionally crafted logos designed to elevate your brand instantly</p></div><div><h4 class="text-xs font-bold uppercase tracking-widest mb-4">Quick Links</h4><ul class="space-y-3 text-sm text-gray-600"><li><a href="all-items">Browse Logos</a></li><li><a href="designers">Designers</a></li><li><a href="top-rated">Top Rated</a></li><li><a href="sold-out">Sold Logos</a></li><li><a href="feeds">Feeds</a></li></ul></div><div><h4 class="text-xs font-bold uppercase tracking-widest mb-4">Informations</h4><ul class="space-y-3 text-sm text-gray-600"><li><a href="how-it-works">How it Works</a></li><li><a href="faq">F.A.Q</a></li><li><a href="return-policy">Return Policy</a></li><li><a href="privacy-policy">Privacy Policy</a></li><li><a href="term-conditions">Terms & Conditions</a></li></ul></div><div><h4 class="text-xs font-bold uppercase tracking-widest mb-4">Contact</h4><ul class="space-y-4 text-sm"><li><a href="javascript::" onclick="openModal('information/saran'); return false;" class="font-semibold text-gray-800"> Suggestions Box</a></li><li><a href="ja